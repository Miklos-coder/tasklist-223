<!DOCTYPE html>
<html lang="de">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tasklist</title></head>
<body>
  <h1>Tasklist</h1>
  <nav><a href="/aufgaben/neu">Neue Aufgabe erfassen</a> | <a href="/registrieren">Registrieren</a> | <a href="/benutzer">Benutzerübersicht</a></nav>
  <% if (tasks.length === 0) { %>
    <p>Keine Aufgaben vorhanden.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Titel</th><th>Beschreibung</th><th>Fälligkeitsdatum</th><th>Status</th><th>Ersteller</th><th>Zugewiesen an</th><th>Aktionen</th></tr></thead>
      <tbody>
        <% tasks.forEach((task) => { %>
          <tr>
            <td<% if (task.done) { %> style="text-decoration: line-through;"<% } %>><%= task.title %></td>
            <td><%= task.description %></td>
            <td><%= task.dueDate %></td>
            <td><%= task.done ? 'Erledigt' : 'Offen' %></td>
            <td><%= task.creator.email %></td>
            <td>
              <form action="/aufgaben/<%= task.id %>/zuweisen" method="post">
                <label for="assignee-<%= task.id %>">Zuweisung</label>
                <select id="assignee-<%= task.id %>" name="assigneeId">
                  <option value=""<% if (task.assigneeId === null) { %> selected<% } %>>Nicht zugewiesen</option>
                  <% users.forEach((user) => { %>
                    <option value="<%= user.id %>"<% if (task.assigneeId === user.id) { %> selected<% } %>><%= user.email %></option>
                  <% }) %>
                </select>
                <button type="submit">Zuweisung speichern</button>
              </form>
            </td>
            <td>
              <% if (!task.done) { %>
                <form action="/aufgaben/<%= task.id %>/erledigen" method="post"><button type="submit">Als erledigt markieren</button></form>
              <% } %>
              <form action="/aufgaben/<%= task.id %>/loeschen" method="post"><button type="submit">Löschen</button></form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
