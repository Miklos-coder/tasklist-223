<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Tasklist</title>
</head>
<body>
  <h1>Tasklist</h1>
  <a href="/aufgaben/neu">Neue Aufgabe erfassen</a>

  <% if (tasks.length === 0) { %>
    <p>Keine Aufgaben vorhanden.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Titel</th>
          <th>Beschreibung</th>
          <th>Fälligkeitsdatum</th>
          <th>Status</th>
          <th>Aktionen</th>
        </tr>
      </thead>
      <tbody>
        <% tasks.forEach((task) => { %>
          <tr<% if (task.done) { %> style="text-decoration: line-through;"<% } %>>
            <td><%= task.title %></td>
            <td><%= task.description %></td>
            <td><%= task.dueDate %></td>
            <td><%= task.done ? 'Erledigt' : 'Offen' %></td>
            <td>
              <form action="/aufgaben/<%= task.id %>/erledigen" method="post">
                <button type="submit">Als erledigt markieren</button>
              </form>
              <form action="/aufgaben/<%= task.id %>/loeschen" method="post">
                <button type="submit">Löschen</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
