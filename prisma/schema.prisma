generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(191)
  description String   @db.Text
  dueDate     DateTime @db.Date
  done        Boolean  @default(false)
}
